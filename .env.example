# 阿里云百炼 API Key（用于视频总结 AI 功能）
# 获取地址：https://bailian.console.aliyun.com/
ALIYUN_API_KEY=

# OpenAI API Key（备选）
OPENAI_API_KEY=

# JWT 密钥（生产环境请修改）
SECRET_KEY=your-secret-key-change-in-production

# Stripe 支付配置
# 获取方式：https://dashboard.stripe.com/ → Developers → API keys
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
# Webhook 签名密钥：运行 `stripe listen --forward-to localhost:8000/api/payment/webhook` 获得
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
# VIP 会员 Price ID：在 Stripe Dashboard → Products 创建产品后获得
STRIPE_VIP_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxx
